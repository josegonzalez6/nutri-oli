# Public browser-safe Supabase values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only values. Never expose these to client components or commit real values.
SUPABASE_SERVICE_ROLE_KEY=replace-only-in-secure-server-environments

# Application configuration.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_DEFAULT_TIME_ZONE=Europe/Madrid
